module Gl {
  alien javascript "/lib/carmak.js" {

		# Values, could better define as val : Type;, but need to figure out
		# how to pass variabled from JS to here
		color_buffer_bit : () -> Int;

		# Functions
    clearColor : forall e::Row . (Float, Float, Float, Float) ~e~> ();
    clear : forall e::Row . (Int) ~e~> ();

  }
}

# Global records
var window = (width = -1, height = -1);


# General function wrappers
alien javascript "/lib/carmak.js" {
		# Functions
		createContext : forall e::Row . (String) ~e~> ();
		getContext : () -> String;

		fill : (Int, Int, Int) ~> ();
		rect : (Int, Int, Int, Int) ~> ();
}

sig updateWindowSize : (Int, Int) -> ()
fun updateWindowSize(w, h) {
		ignore((window with width = w));
		ignore((window with height = h))
}

# Main rendering function, WIP
sig render : (Int, Int) -> Xml
fun render(width, height) {
		ignore(updateWindowSize(width, height));
		<#>
				<canvas id="game-window" 
				width="{intToString(width)}"
				height="{intToString(height)}" />
		</#>
}
