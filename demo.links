open import Carmak;

fun mainPage(_) {

  # need to spawn a client for alien calls
  var _ = spawnClient {
		createContext("2d");

		fill(255, 0, 0);

		rect(50, 10, 50, 50)

		#Gl.clearColor(1.0, 0.0, 0.0, 1.0);
		#Gl.clear(Gl.color_buffer_bit())
  };

  #Mvu.run("placeholder", defaultGame, view,
  #    fun(msg, model) { (updt(msg, model), MvuCommands.empty) },
  #    subscriptions, MvuCommands.empty);
  page
  <html>
    <head>
      <title>Carmak Demo</title>
    </head>
    <body>
				{render(640, 480)}
    </body>
  </html>
}

fun main() {
  addRoute("/", mainPage);
	# Optional
  addStaticRoute("/lib", "js", [("js", "text/javascript")]);
  servePages()
}

main()
